# ローカルDocker Postgres用の接続情報
# コピーして .env を作成してください: cp .env.sample .env
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_NAME=pet_health_development

# Supabase接続情報(本番用)
# 注意: DATABASE_URLという名前は使わないこと(Railsが環境を問わず自動的に読み込んでしまうため、
# development実行時に誤って本番Supabaseへ接続する事故につながる)
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
