<div class="hero min-h-[70vh]">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold">うちの子ライフ</h1>
      <p class="py-6">日々の食事や投薬、健康状態を手軽に記録できるアプリです。</p>

      <% if user_signed_in? %>
        <% if @pets.present? %>
          <ul class="flex flex-col gap-2 mb-4">
            <% @pets.each do |pet| %>
              <li class="flex items-center justify-between gap-2">
                <span><%= pet.name %></span>
                <%= link_to "見る", pet_path(pet), class: "btn btn-sm btn-primary" %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <%= link_to "ペットを登録する", new_pet_path, class: "btn btn-outline" %>
        <%= link_to "食事の種類を管理する", meal_types_path, class: "btn btn-outline" %>
        <%= link_to "食事の単位を管理する", meal_units_path, class: "btn btn-outline" %>
        <%= link_to "薬の種類を管理する", medicine_types_path, class: "btn btn-outline" %>
        <%= link_to "病院名を管理する", hospital_names_path, class: "btn btn-outline" %>
        <%= link_to "ワクチンの種類を管理する", vaccine_types_path, class: "btn btn-outline" %>
      <% else %>
        <%= button_to "ゲストとして始める", guest_sign_in_path, method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
