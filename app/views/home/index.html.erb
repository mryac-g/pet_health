<div class="max-w-md md:max-w-4xl mx-auto w-full">
  <% if user_signed_in? %>
    <div class="mb-6">
      <p class="text-sm opacity-70">ホーム</p>
      <h1 class="text-2xl font-bold">おかえりなさい、<%= current_user.display_name %>さん</h1>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <% @pets.each do |pet| %>
        <%= link_to pet_path(pet), class: "flex flex-col items-center text-center gap-2 p-6 rounded-2xl bg-base-100 border border-base-300 hover:shadow transition" do %>
          <%= render "shared/species_avatar", pet: pet, avatar_size: "w-16 h-16", avatar_icon_size: "w-8 h-8" %>
          <p class="font-bold"><%= pet.name %></p>
          <p class="text-sm opacity-70">
            <%= Pet::SPECIES_LABELS[pet.species] %><%= "(#{pet.species_note})" if pet.species_note.present? %>
          </p>
        <% end %>
      <% end %>

      <%= link_to new_pet_path, class: "flex flex-col items-center justify-center gap-2 p-6 rounded-2xl border-2 border-dashed border-base-300 text-base-content/60 hover:border-primary hover:text-primary transition" do %>
        <span class="text-3xl leading-none">+</span>
        <span class="text-sm">新しい家族を追加</span>
      <% end %>
    </div>
  <% else %>
    <div class="min-h-[70vh] flex flex-col items-center justify-center text-center">
      <div class="w-full max-w-lg rounded-3xl bg-[var(--glass)] border border-[var(--border)] backdrop-blur-md shadow-xl px-8 py-10 sm:px-14 sm:py-12">
        <%= image_tag "welcome/paw_trail.png", alt: "", class: "w-52 h-auto mx-auto mb-8" %>

        <%= image_tag "welcome/logo_wordmark.png", alt: "うちの子ノート", class: "w-4/5 max-w-xs sm:max-w-sm h-auto mx-auto mb-6" %>

        <p class="text-[var(--muted)] mb-10 break-keep">
          日々の食事や投薬、健康状態を<br class="hidden sm:block">
          手軽に記録できるアプリです。
        </p>

        <%= button_to guest_sign_in_path, method: :post,
              class: "btn btn-xs border-0 text-white bg-[linear-gradient(135deg,var(--a1),var(--a2))] hover:opacity-90 rounded-full px-8" do %>
          ゲストとして始める →
        <% end %>

        <p class="text-sm text-[var(--muted)] mt-8">
          登録なしでも<span class="font-bold">すぐにお試しいただけます</span>
        </p>
      </div>

      <p class="text-sm text-[var(--muted)] mt-10">© うちの子ノート</p>
    </div>
  <% end %>
</div>
