<div class="hero min-h-[70vh]">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold">うちの子ライフ</h1>
      <p class="py-6">日々の食事や投薬、健康状態を手軽に記録できるアプリです。</p>

      <% if user_signed_in? %>
        <%= link_to "ペットを登録する", new_pet_path, class: "btn btn-primary" %>
      <% else %>
        <%= button_to "ゲストとして始める", guest_sign_in_path, method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
