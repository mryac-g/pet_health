<div class="max-w-md md:max-w-4xl mx-auto w-full">
  <% if user_signed_in? %>
    <div class="mb-6">
      <p class="text-sm opacity-70">ホーム</p>
      <h1 class="text-2xl font-bold">おかえりなさい、<%= current_user.display_name %>さん</h1>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <% @pets.each do |pet| %>
        <%= link_to pet_path(pet), class: "flex flex-col items-center text-center gap-2 p-6 rounded-2xl bg-base-100 border border-base-300 hover:shadow transition" do %>
          <%= render "shared/species_avatar", pet: pet, avatar_size: "w-16 h-16", avatar_icon_size: "w-8 h-8" %>
          <p class="font-bold"><%= pet.name %></p>
          <p class="text-sm opacity-70">
            <%= Pet::SPECIES_LABELS[pet.species] %><%= "(#{pet.species_note})" if pet.species_note.present? %>
          </p>
        <% end %>
      <% end %>

      <%= link_to new_pet_path, class: "flex flex-col items-center justify-center gap-2 p-6 rounded-2xl border-2 border-dashed border-base-300 text-base-content/60 hover:border-primary hover:text-primary transition" do %>
        <span class="text-3xl leading-none">+</span>
        <span class="text-sm">新しい家族を追加</span>
      <% end %>
    </div>
  <% else %>
    <div class="min-h-[70vh] flex flex-col items-center justify-center text-center">
      <div class="w-full max-w-md rounded-3xl bg-[var(--glass)] border border-[var(--border)] backdrop-blur-md shadow-xl px-6 py-10 sm:px-10">
        <svg viewBox="0 0 300 100" class="w-40 h-auto mx-auto mb-1" aria-hidden="true">
          <defs>
            <linearGradient id="pawTrailGradient" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--a1)" />
              <stop offset="100%" stop-color="var(--a2)" />
            </linearGradient>
          </defs>
          <g fill="url(#pawTrailGradient)">
            <circle cx="10" cy="90" r="3" />
            <circle cx="52" cy="63" r="4" />
            <circle cx="94" cy="42" r="5" />
            <circle cx="136" cy="27" r="6.5" />
            <g>
              <circle cx="178" cy="19" r="8" />
              <circle cx="171" cy="6" r="2.4" />
              <circle cx="180" cy="2" r="2.4" />
              <circle cx="189" cy="6" r="2.4" />
            </g>
            <g>
              <circle cx="220" cy="16" r="9.5" />
              <circle cx="212" cy="1" r="2.8" />
              <circle cx="222" cy="-3" r="2.8" />
              <circle cx="232" cy="1" r="2.8" />
            </g>
            <g>
              <circle cx="262" cy="19" r="11" />
              <circle cx="252" cy="3" r="3.2" />
              <circle cx="263" cy="-2" r="3.2" />
              <circle cx="274" cy="3" r="3.2" />
            </g>
          </g>
        </svg>

        <%= image_tag "welcome/logo_wordmark.png", alt: "うちの子ログ", class: "h-14 sm:h-16 w-auto mx-auto mb-4" %>

        <p class="text-[var(--muted)] mb-6">
          日々の食事や投薬、健康状態を<br class="hidden sm:block">
          手軽に記録できるアプリです。
        </p>

        <%= button_to guest_sign_in_path, method: :post,
              class: "btn w-full border-0 text-white bg-[linear-gradient(135deg,var(--a1),var(--a2))] hover:opacity-90 rounded-full text-base" do %>
          ゲストとして始める →
        <% end %>

        <div class="flex gap-3 mt-3">
          <%= link_to "アカウント登録", new_user_registration_path, class: "btn btn-sm btn-outline flex-1 rounded-full" %>
          <%= link_to "ログイン", new_user_session_path, class: "btn btn-sm btn-outline flex-1 rounded-full" %>
        </div>

        <p class="text-sm text-[var(--muted)] mt-5">
          登録なしでも<span class="text-[var(--a-ink)] font-bold">すぐにお試しいただけます</span>
        </p>
      </div>

      <p class="text-sm text-[var(--muted)] mt-8">© うちの子ログ</p>
    </div>
  <% end %>
</div>
