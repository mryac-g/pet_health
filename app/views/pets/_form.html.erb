<%= form_with model: pet, local: true, multipart: true, class: "flex flex-col gap-4" do |f| %>
  <% if pet.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul>
        <% pet.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-control">
    <%= f.label :name, "名前", class: "label" %>
    <%= f.text_field :name, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control">
    <%= f.label :species, "種類", class: "label" %>
    <%= f.select :species, Pet::SPECIES_LABELS.map { |key, label| [label, key] }, {}, class: "select select-bordered w-full" %>
  </div>

  <div class="form-control">
    <%= f.label :species_note, "その他の場合の詳細", class: "label" %>
    <%= f.text_field :species_note, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control">
    <%= f.label :birthday, "誕生日", class: "label" %>
    <%= f.date_field :birthday, max: Date.current, class: "input input-bordered w-full cursor-pointer",
          data: { controller: "datetime-picker", action: "click->datetime-picker#open" } %>
  </div>

  <div class="form-control">
    <%= f.label :welcomed_on, "お迎えした日", class: "label" %>
    <%= f.date_field :welcomed_on, max: Date.current, class: "input input-bordered w-full cursor-pointer",
          data: { controller: "datetime-picker", action: "click->datetime-picker#open" } %>
  </div>

  <div class="form-control">
    <span class="label">記録する項目</span>
    <div class="grid grid-cols-2 gap-2">
      <%= f.collection_check_boxes :record_type_keys, CareRecord::RECORD_TYPE_LABELS.to_a, :first, :last do |b| %>
        <label class="flex items-center gap-2">
          <%= b.check_box(class: "checkbox") %>
          <%= b.text %>
        </label>
      <% end %>
    </div>
  </div>

  <% if pet.persisted? && pet.icon_download_url.present? %>
    <img src="<%= pet.icon_download_url %>" alt="<%= pet.name %>のアイコン" class="w-24 h-24 object-cover rounded-full">
  <% end %>

  <div class="form-control">
    <%= label_tag "pet_icon", "アイコン画像", class: "label" %>
    <%= file_field_tag "pet[icon]", class: "file-input file-input-bordered w-full" %>
  </div>

  <p class="text-sm opacity-70 my-4 text-center">登録内容や記録する項目は あとからかんたんに変更できます</p>

  <%= f.submit submit_label, class: "btn btn-primary mt-2" %>
<% end %>
