<div class="max-w-md md:max-w-5xl mx-auto w-full" data-controller="clipboard print scroll-into-view summary-view-toggle"
     data-scroll-into-view-target-value="<%= @scroll_to %>">
  <%= link_to "← #{@pet.name}のページに戻る", pet_path(@pet), class: "link text-sm mb-4 inline-block print:hidden" %>

  <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
    <h1 class="text-2xl font-bold"><%= @pet.name %>のサマリー</h1>
    <div class="flex gap-2 print:hidden">
      <button type="button" data-clipboard-target="button" data-action="clipboard#copy" class="btn btn-sm btn-primary">コピーする</button>
      <button type="button" data-action="print#print" class="btn btn-sm btn-outline">印刷する</button>
      <%= link_to "PDFをダウンロード", summary_pet_path(@pet, format: :pdf), class: "btn btn-sm btn-outline", data: { turbo: false } %>
    </div>
  </div>

  <p class="text-sm opacity-70 mb-4 print:hidden">通院時の説明などにお使いください。</p>

  <%= form_with url: summary_pet_path(@pet), method: :get, class: "flex flex-col gap-3 mb-6 print:hidden" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="form-control">
        <label for="period" class="label text-xs">期間プリセット</label>
        <%= select_tag :period,
              options_for_select([["選択してください", ""]] + DateRangeFilterable::PERIOD_PRESETS.map { |key, (label, _)| [label, key] }, @period),
              onchange: "this.form.requestSubmit()", class: "select select-bordered select-sm" %>
      </div>
      <div class="form-control">
        <label for="from" class="label text-xs">開始日</label>
        <input type="date" name="from" id="from" value="<%= @from %>" class="input input-bordered input-sm" />
      </div>
      <div class="form-control">
        <label for="to" class="label text-xs">終了日</label>
        <input type="date" name="to" id="to" value="<%= @to %>" class="input input-bordered input-sm" />
      </div>
    </div>

    <div class="form-control">
      <span class="label text-xs">サマリーに含める記録</span>
      <div class="flex flex-wrap gap-3">
        <%= hidden_field_tag "record_types[]", "" %>
        <% CareRecord::RECORD_TYPE_LABELS.each do |record_type, label| %>
          <label class="flex items-center gap-1 text-sm">
            <%= check_box_tag "record_types[]", record_type, @record_types.include?(record_type),
                  id: "record_type_#{record_type}", class: "checkbox checkbox-sm" %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>

    <% if @meal_units.any? || @medication_units.any? %>
      <div class="flex flex-wrap items-end gap-3">
        <% if @meal_units.any? %>
          <div class="form-control">
            <label for="meal_unit" class="label text-xs">食事の単位</label>
            <%= select_tag :meal_unit,
                  options_for_select([["すべて", ""]] + @meal_units.map { |unit| [unit, unit] }, @meal_unit),
                  onchange: "this.form.requestSubmit()", class: "select select-bordered select-sm" %>
          </div>
        <% end %>
        <% if @medication_units.any? %>
          <div class="form-control">
            <label for="medication_unit" class="label text-xs">投薬の単位</label>
            <%= select_tag :medication_unit,
                  options_for_select([["すべて", ""]] + @medication_units.map { |unit| [unit, unit] }, @medication_unit),
                  onchange: "this.form.requestSubmit()", class: "select select-bordered select-sm" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex gap-3">
        <label class="flex items-center gap-1 text-sm">
          <%= radio_button_tag :group_by, "record_type", @group_by == "record_type", class: "radio radio-sm" %>
          記録項目ごと
        </label>
        <label class="flex items-center gap-1 text-sm">
          <%= radio_button_tag :group_by, "date", @group_by == "date", class: "radio radio-sm" %>
          日付ごと
        </label>
      </div>

      <div class="flex gap-2">
        <button type="submit" class="btn btn-sm btn-outline">表示する</button>
        <%= link_to "解除",
              summary_pet_path(@pet, from: "", to: "", record_types: [""], group_by: PetsController::DEFAULT_SUMMARY_GROUP_BY,
                meal_unit: "", medication_unit: ""),
              class: "btn btn-sm btn-ghost" %>
      </div>
    </div>
  <% end %>

  <%# コピー用の生テキスト。画面には出さず、コピーするボタンからのみ参照する %>
  <textarea readonly data-clipboard-target="source" class="hidden" aria-hidden="true"><%= @summary_text %></textarea>
  <pre class="hidden print:block whitespace-pre-wrap font-mono text-sm"><%= @summary_text %></pre>

  <%# 文章・グラフの表示切り替え。画面表示のみに影響し、PDF・印刷は常に両方を出力する
      (PDFはGroverがこのページを最初から独立して読み込んで生成するため、この
      切り替え状態の影響を受けない) %>
  <div class="flex gap-2 mb-4 print:hidden">
    <button type="button" data-mode="text" data-action="summary-view-toggle#showText"
            data-summary-view-toggle-target="button" class="btn btn-xs btn-outline">文章のみ</button>
    <button type="button" data-mode="graph" data-action="summary-view-toggle#showGraph"
            data-summary-view-toggle-target="button" class="btn btn-xs btn-outline">グラフのみ</button>
    <button type="button" data-mode="both" data-action="summary-view-toggle#showBoth"
            data-summary-view-toggle-target="button" class="btn btn-xs btn-outline btn-active">両方</button>
  </div>

  <div class="md:flex md:gap-6 md:items-start">
    <%# 画面表示用。まとめ文章の各行に「編集する」ボタンを添えて、その記録の編集画面に
        直接遷移できるようにする。ボタンはprint:hiddenでPDF・印刷には出ない %>
    <div data-summary-view-toggle-target="text"
         class="textarea textarea-bordered w-full md:flex-1 min-h-96 font-mono text-sm print:hidden">
      <p class="whitespace-pre-wrap">【<%= @pet.name %>のケア記録サマリー】</p>
      <p class="whitespace-pre-wrap mb-3">期間: <%= @from ? @from.strftime("%Y/%m/%d") : "全期間" %> 〜 <%= (@to || Date.current).strftime("%Y/%m/%d") %></p>
      <% if @summary_entries.empty? %>
        <p>該当期間の記録はありません。</p>
      <% else %>
        <% @summary_entries.each do |entry| %>
          <% if entry[:header] %>
            <p class="font-bold mt-3 mb-1">■ <%= entry[:header] %></p>
          <% else %>
            <ul class="list-disc list-outside pl-5">
              <li id="care_record_<%= entry[:care_record].id %>">
                <div class="flex items-center justify-between gap-2">
                  <span><%= entry[:text] %></span>
                  <%= link_to "編集する",
                        edit_pet_care_record_path(@pet, entry[:care_record],
                          return_to: summary_pet_path(@pet, request.query_parameters.merge(scroll_to: "care_record_#{entry[:care_record].id}"))),
                        class: "btn btn-xs btn-outline no-underline flex-shrink-0" %>
                </div>
              </li>
            </ul>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div data-summary-view-toggle-target="graph" class="mt-8 md:mt-0 md:flex-1 flex flex-col gap-4">
      <% CareRecord::RECORD_TYPE_LABELS.each_key do |record_type| %>
        <% Array(@graph_series_by_type[record_type]).each do |series| %>
          <%= render "care_records/graph_canvas", series: series %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="flex gap-2 mt-4 print:hidden">
    <%= link_to "ペットページに戻る", pet_path(@pet), class: "btn btn-sm" %>
  </div>
</div>
