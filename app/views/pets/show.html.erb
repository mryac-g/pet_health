<div class="max-w-md md:max-w-4xl mx-auto w-full">
  <% pet_content = capture do %>
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <%= render "shared/species_avatar", pet: @pet %>
        <div>
          <h1 class="text-2xl font-bold"><%= @pet.name %></h1>
          <p class="text-sm opacity-70">
            <%= Pet::SPECIES_LABELS[@pet.species] %><%= "(#{@pet.species_note})" if @pet.species_note.present? %>
            <% if @pet.birthday.present? %>
              ・<%= @pet.birthday.strftime("%Y/%m/%d") %>
            <% end %>
          </p>
        </div>
      </div>
      <div class="flex gap-2">
        <%= link_to "プロフィールを編集する", edit_pet_path(@pet), class: "btn btn-sm btn-outline" %>
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-sm btn-outline">記録項目を編集</div>
          <div tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-64 p-3 shadow mt-1">
            <p class="font-semibold text-sm mb-2">記録する項目</p>
            <%= form_with model: @pet, url: pet_path(@pet), method: :patch do |f| %>
              <div class="flex flex-col gap-1">
                <%= f.collection_check_boxes :record_type_keys, CareRecord::RECORD_TYPE_LABELS.to_a, :first, :last do |b| %>
                  <label class="flex items-center gap-2 text-sm">
                    <%= b.check_box(class: "checkbox checkbox-sm") %>
                    <%= b.text %>
                  </label>
                <% end %>
              </div>
              <%= f.submit "更新する", class: "btn btn-primary btn-sm w-full mt-2" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="flex gap-2 mb-6">
      <%= link_to "記録を見る", pet_care_records_path(@pet), class: "btn btn-sm btn-outline" %>
      <%= link_to "サマリーを見る", summary_pet_path(@pet), class: "btn btn-sm btn-outline" %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <% @pet.record_type_keys.each do |record_type| %>
        <% label = CareRecord::RECORD_TYPE_LABELS[record_type] %>
        <% last_record = @latest_care_records[record_type] %>
        <div class="relative rounded border border-base-300 bg-base-100 p-4 pr-10">
          <%= link_to pet_care_records_path(@pet, record_type: record_type), class: "block" do %>
            <div class="font-semibold"><%= label %></div>
            <% if last_record %>
              <div class="text-sm opacity-70 mt-1 truncate">
                <%= last_record.detail_summary || last_record.note.presence || "記録あり" %>
              </div>
              <div class="text-xs opacity-50"><%= last_record.recorded_at.strftime("%m/%d %H:%M") %></div>
            <% else %>
              <div class="text-sm opacity-50 mt-1">記録なし</div>
            <% end %>
          <% end %>
          <%= link_to "＋", new_pet_care_record_path(@pet, record_type: record_type, return_to: pet_path(@pet)),
                class: "btn btn-circle btn-sm btn-primary absolute top-2 right-2" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @pets.size > 1 %>
    <div role="tablist" class="tabs tabs-lift md:hidden">
      <% @pets.each do |pet| %>
        <%= link_to pet.name, pet_path(pet), role: "tab", class: ["tab", ("tab-active" if pet == @pet)] %>
        <% if pet == @pet %>
          <div class="tab-content bg-base-100 border-base-300 p-4"><%= pet_content %></div>
        <% end %>
      <% end %>
    </div>
    <div class="hidden md:block"><%= pet_content %></div>
  <% else %>
    <%= pet_content %>
  <% end %>
</div>
