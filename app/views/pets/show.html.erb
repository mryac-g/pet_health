<div class="max-w-md md:max-w-4xl mx-auto w-full">
  <% pet_content = capture do %>
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <% if @pet.icon_download_url.present? %>
          <img src="<%= @pet.icon_download_url %>" alt="<%= @pet.name %>のアイコン" class="w-12 h-12 object-cover rounded-full">
        <% else %>
          <div class="avatar avatar-placeholder">
            <div class="bg-neutral text-neutral-content w-12 rounded-full">
              <span><%= @pet.name.first %></span>
            </div>
          </div>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold"><%= @pet.name %></h1>
          <p class="text-sm opacity-70">
            <%= Pet::SPECIES_LABELS[@pet.species] %><%= "(#{@pet.species_note})" if @pet.species_note.present? %>
            <% if @pet.birthday.present? %>
              ・<%= @pet.birthday.strftime("%Y/%m/%d") %>
            <% end %>
          </p>
        </div>
      </div>
      <div class="flex gap-2">
        <%= link_to "編集する", edit_pet_path(@pet), class: "btn btn-sm btn-outline" %>
        <%= link_to "ペットを登録する", new_pet_path, class: "btn btn-sm btn-outline" %>
      </div>
    </div>

    <div class="flex gap-2 mb-6">
      <%= link_to "記録を見る", pet_care_records_path(@pet), class: "btn btn-sm btn-outline" %>
      <%= link_to "サマリーを見る", summary_pet_path(@pet), class: "btn btn-sm btn-outline" %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      <% CareRecord::RECORD_TYPE_LABELS.each do |record_type, label| %>
        <% last_record = @latest_care_records[record_type] %>
        <div class="relative rounded border border-base-300 p-3 pr-9">
          <%= link_to pet_care_records_path(@pet, record_type: record_type), class: "block" do %>
            <div class="font-semibold text-sm"><%= label %></div>
            <% if last_record %>
              <div class="text-xs opacity-70 mt-1 truncate">
                <%= last_record.detail_summary || last_record.note.presence || "記録あり" %>
              </div>
              <div class="text-xs opacity-50"><%= last_record.recorded_at.strftime("%m/%d %H:%M") %></div>
            <% else %>
              <div class="text-xs opacity-50 mt-1">記録なし</div>
            <% end %>
          <% end %>
          <%= link_to "＋", new_pet_care_record_path(@pet, record_type: record_type, return_to: pet_path(@pet)),
                class: "btn btn-circle btn-xs btn-primary absolute top-2 right-2" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @pets.size > 1 %>
    <div role="tablist" class="tabs tabs-lift">
      <% @pets.each do |pet| %>
        <%= link_to pet.name, pet_path(pet), role: "tab", class: ["tab", ("tab-active" if pet == @pet)] %>
        <% if pet == @pet %>
          <div class="tab-content bg-base-100 border-base-300 p-4 md:p-6"><%= pet_content %></div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= pet_content %>
  <% end %>
</div>
