<div class="max-w-md mx-auto w-full">
  <h1 class="text-2xl font-bold mb-2">アカウント登録</h1>
  <p class="text-sm opacity-70 mb-6">
    メールアドレスとパスワードを設定すると、今のペットや記録はそのまま引き継いだ状態で、正式なアカウントに切り替わります。
  </p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-control">
      <%= f.label :name, "ユーザー名", class: "label" %>
      <%= f.text_field :name, autocomplete: "name", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, value: nil, placeholder: "example@email.com", required: true,
            autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :password, class: "label" %>
      <% if @minimum_password_length %>
        <em class="text-xs opacity-70"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></em>
      <% end %>
      <%= f.password_field :password, required: true, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :password_confirmation, class: "label" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <%= f.submit "アカウント登録する", class: "btn btn-primary mt-2" %>
  <% end %>

  <%= link_to t("devise.shared.links.back"), :back, class: "link text-sm mt-4 inline-block" %>
</div>
