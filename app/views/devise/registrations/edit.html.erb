<div class="max-w-md mx-auto w-full">
  <h1 class="text-2xl font-bold mb-6">
    <% if resource.guest? %>
      アカウント登録
    <% else %>
      <%= t(".title", resource: devise_i18n_fix_model_name_case(resource.model_name.human, i18n_key: "registrations.edit.title")) %>
    <% end %>
  </h1>

  <% if resource.guest? %>
    <p class="text-sm opacity-70 mb-4">
      メールアドレスとパスワードを設定すると、今のペットや記録はそのまま引き継いだ状態で、正式なアカウントに切り替わります。
    </p>
  <% end %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-control">
      <%= f.label :name, "ユーザー名", class: "label" %>
      <%= f.text_field :name, autocomplete: "name", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, value: (resource.guest? ? nil : f.object.email), placeholder: "example@email.com",
            autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div role="alert" class="alert"><%= t(".currently_waiting_confirmation_for_email", email: resource.unconfirmed_email) %></div>
    <% end %>

    <div class="form-control">
      <%= f.label :password, class: "label" %>
      <span class="text-xs opacity-70">(<%= t(".leave_blank_if_you_don_t_want_to_change_it") %>)</span>
      <% if @minimum_password_length %>
        <em class="text-xs opacity-70"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :password_confirmation, class: "label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <% unless resource.guest? %>
      <div class="form-control">
        <%= f.label :current_password, class: "label" %>
        <span class="text-xs opacity-70">(<%= t(".we_need_your_current_password_to_confirm_your_changes") %>)</span>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "input input-bordered w-full" %>
      </div>
    <% end %>

    <%= f.submit (resource.guest? ? "アカウント登録する" : t(".update")), class: "btn btn-primary mt-2" %>
  <% end %>

  <% unless resource.guest? %>
    <div class="mt-6 pt-6 border-t border-base-300">
      <h2 class="font-bold mb-2"><%= t(".cancel_my_account") %></h2>
      <%= button_to t(".cancel_my_account"), registration_path(resource_name),
            method: :delete, class: "btn btn-sm btn-error",
            data: { confirm: t(".are_you_sure"), turbo_confirm: t(".are_you_sure") } %>
    </div>
  <% end %>

  <%= link_to t("devise.shared.links.back"), :back, class: "link text-sm mt-4 inline-block" %>
</div>
