<div class="min-h-[70vh] flex items-center justify-center">
<div class="max-w-md w-full rounded-3xl bg-[var(--glass)] border border-[var(--glass-border)] backdrop-blur-md shadow-xl px-6 py-10 sm:px-10">
  <h1 class="text-2xl font-bold mb-6"><%= t(".sign_up") %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-control">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :password, class: "label" %>
      <% if @minimum_password_length %>
        <em class="text-xs opacity-70"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= f.label :password_confirmation, class: "label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <%= f.submit t(".sign_up"), class: "btn btn-primary mt-2" %>
  <% end %>

  <div class="flex flex-col gap-1 mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
</div>
