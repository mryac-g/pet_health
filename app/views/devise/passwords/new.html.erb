<div class="min-h-[70vh] flex items-center justify-center">
<div class="max-w-md w-full rounded-3xl bg-[var(--glass)] border border-[var(--border)] backdrop-blur-md shadow-xl px-6 py-10 sm:px-10">
  <h1 class="text-2xl font-bold mb-6"><%= t(".forgot_your_password") %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-control">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>

    <%= f.submit t(".send_me_reset_password_instructions"), class: "btn btn-primary mt-2" %>
  <% end %>

  <div class="flex flex-col gap-1 mt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
</div>
