<%# locals: (f:, care_record:) %>
<%= f.hidden_field :record_type %>

<div class="form-control">
  <%= f.label :recorded_at, "記録日時", class: "label" %>
  <span class="text-xs opacity-70 mb-1">24時間表記で入力してください</span>
  <%= f.datetime_field :recorded_at, step: 60,
        value: f.object.recorded_at&.strftime("%Y-%m-%dT%H:%M"),
        class: "input input-bordered w-full max-w-xs" %>
</div>
