<%# locals: (f:, care_record:) %>
<%= f.hidden_field :record_type %>

<div class="form-control">
  <div class="flex items-center gap-2 flex-wrap">
    <%= f.label :recorded_at, "記録日時", class: "label" %>
    <span class="text-xs opacity-70">24時間表記で入力してください</span>
  </div>
  <%= f.datetime_field :recorded_at, step: 60,
        value: f.object.recorded_at&.strftime("%Y-%m-%dT%H:%M"),
        class: "input input-bordered input-sm w-auto cursor-pointer",
        data: { controller: "datetime-picker", action: "click->datetime-picker#open" } %>
</div>
