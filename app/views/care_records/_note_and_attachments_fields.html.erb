<%# locals: (f:) %>
<div class="form-control">
  <%= f.label :note, "メモ", class: "label" %>
  <%= f.text_area :note, class: "textarea textarea-bordered w-full" %>
</div>

<div class="form-control">
  <%= label_tag "care_record_files", "添付ファイル(画像・動画・書類)", class: "label" %>
  <%= file_field_tag "care_record[files][]", multiple: true, class: "file-input file-input-bordered w-full" %>
</div>
