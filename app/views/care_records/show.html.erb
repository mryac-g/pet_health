<div class="max-w-md mx-auto w-full">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= CareRecord::RECORD_TYPE_LABELS[@care_record.record_type] %>の記録</h1>
    <div class="flex gap-2">
      <%= link_to "編集する", edit_pet_care_record_path(@pet, @care_record), class: "btn btn-sm btn-outline" %>
      <%= button_to "削除する", pet_care_record_path(@pet, @care_record), method: :delete,
            class: "btn btn-sm btn-error",
            data: { turbo_confirm: "この記録を削除しますか？" } %>
    </div>
  </div>

  <dl class="flex flex-col gap-3">
    <div>
      <dt class="text-sm opacity-70">記録日時</dt>
      <dd><%= @care_record.recorded_at.strftime("%Y/%m/%d %H:%M") %></dd>
    </div>

    <% case @care_record.record_type %>
    <% when "meal" %>
      <% if @care_record.meal %>
        <% if @care_record.meal.food_name.present? %>
          <div>
            <dt class="text-sm opacity-70">食事の種類</dt>
            <dd><%= @care_record.meal.food_name %></dd>
          </div>
        <% end %>
        <div>
          <dt class="text-sm opacity-70">食事量</dt>
          <dd><%= @care_record.meal.amount %>g</dd>
        </div>
        <div>
          <dt class="text-sm opacity-70">完食率</dt>
          <dd><%= display_or_unselected @care_record.meal.completion_rate, suffix: "%" %></dd>
        </div>
      <% end %>
    <% when "weight" %>
      <% if @care_record.weight %>
        <div>
          <dt class="text-sm opacity-70">体重</dt>
          <dd><%= @care_record.weight.weight %>kg</dd>
        </div>
      <% end %>
    <% when "temperature" %>
      <% if @care_record.temperature %>
        <div>
          <dt class="text-sm opacity-70">体温</dt>
          <dd><%= @care_record.temperature.temperature %>℃</dd>
        </div>
      <% end %>
    <% when "medication" %>
      <% if @care_record.medication %>
        <div>
          <dt class="text-sm opacity-70">薬の名前</dt>
          <dd><%= @care_record.medication.medicine_name %></dd>
        </div>
        <div>
          <dt class="text-sm opacity-70">用量</dt>
          <dd><%= display_or_unselected @care_record.medication.dosage_amount, suffix: @care_record.medication.dosage_unit %></dd>
        </div>
      <% end %>
    <% when "toilet" %>
      <% if @care_record.toilet %>
        <div>
          <dt class="text-sm opacity-70">種類</dt>
          <dd><%= @care_record.toilet.pee? ? "おしっこ" : "うんち" %></dd>
        </div>
        <% if @care_record.toilet.poop? %>
          <div>
            <dt class="text-sm opacity-70">状態</dt>
            <dd><%= @care_record.toilet.condition.present? ? Toilet::CONDITION_LABELS[@care_record.toilet.condition] : "未選択" %></dd>
          </div>
        <% end %>
      <% end %>
    <% when "walk" %>
      <% if @care_record.walk %>
        <div>
          <dt class="text-sm opacity-70">散歩時間</dt>
          <dd><%= display_or_unselected @care_record.walk.duration_minutes, suffix: "分" %></dd>
        </div>
        <div>
          <dt class="text-sm opacity-70">距離</dt>
          <dd><%= display_or_unselected @care_record.walk.distance, suffix: "km" %></dd>
        </div>
      <% end %>
    <% when "hospital_visit" %>
      <% if @care_record.hospital_visit %>
        <div>
          <dt class="text-sm opacity-70">病院名</dt>
          <dd><%= @care_record.hospital_visit.hospital_name %></dd>
        </div>
        <div>
          <dt class="text-sm opacity-70">ワクチンの種類</dt>
          <dd><%= display_or_unselected @care_record.hospital_visit.vaccine_type %></dd>
        </div>
        <div>
          <dt class="text-sm opacity-70">診断内容</dt>
          <dd><%= @care_record.hospital_visit.diagnosis.present? ? simple_format(@care_record.hospital_visit.diagnosis) : "未選択" %></dd>
        </div>
      <% end %>
    <% end %>

    <% if @care_record.note.present? %>
      <div>
        <dt class="text-sm opacity-70">メモ</dt>
        <dd><%= simple_format @care_record.note %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-6">
    <h2 class="font-bold mb-2">添付ファイル</h2>

    <% if @care_record.attachments.any? %>
      <ul class="flex flex-col gap-1 mb-4">
        <% @care_record.attachments.each do |attachment| %>
          <li class="flex items-center gap-2">
            <%= link_to attachment.file_url, attachment.file_url, target: "_blank", rel: "noopener", class: "link" %>
            <%= button_to "削除", pet_care_record_attachment_path(@pet, @care_record, attachment), method: :delete,
                  class: "btn btn-xs btn-error",
                  data: { turbo_confirm: "このファイルを削除しますか？" } %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with url: pet_care_record_attachments_path(@pet, @care_record), method: :post, scope: :attachment,
          local: true, multipart: true, class: "flex items-center gap-2" do |f| %>
      <%= f.file_field :file, class: "file-input file-input-bordered file-input-sm" %>
      <%= f.submit "アップロード", class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>

  <%= link_to "一覧に戻る", pet_care_records_path(@pet), class: "btn btn-sm mt-6" %>
</div>
