<%# locals: series %>
<div class="mb-6 h-64 break-inside-avoid">
  <h2 class="font-bold mb-2"><%= series[:label] %>の推移</h2>
  <canvas data-controller="line-chart"
          data-line-chart-data-value="<%= series[:points].to_json %>"
          data-line-chart-label-value="<%= series[:label] %>"></canvas>
</div>
