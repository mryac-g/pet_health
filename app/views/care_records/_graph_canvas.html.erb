<%# locals: series %>
<% series[:point_chunks].each_with_index do |chunk, index| %>
  <div class="mb-6 break-inside-avoid">
    <h2 class="font-bold mb-2">
      <%= series[:label] %>の推移
      <% if series[:point_chunks].size > 1 %>
        (<%= index + 1 %>/<%= series[:point_chunks].size %>)
      <% end %>
    </h2>
    <div class="h-64">
      <canvas data-controller="line-chart"
              data-line-chart-data-value="<%= chunk.to_json %>"
              data-line-chart-label-value="<%= series[:label] %>"></canvas>
    </div>
  </div>
<% end %>
