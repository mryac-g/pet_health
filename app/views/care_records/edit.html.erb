<div class="max-w-md mx-auto w-full" data-controller="preset-modal">
  <%= link_to "← #{@pet.name}のページに戻る", @return_to || pet_path(@pet), class: "link text-sm mb-4 inline-block" %>
  <h1 class="text-2xl font-bold mb-6"><%= CareRecord::RECORD_TYPE_LABELS[@care_record.record_type] %>の記録を編集</h1>

  <%= form_with model: @care_record, url: pet_care_record_path(@pet, @care_record), method: :patch, local: true, multipart: true, class: "flex flex-col gap-4" do |f| %>
    <% if @care_record.errors.any? %>
      <div role="alert" class="alert alert-error">
        <ul>
          <% @care_record.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= render "fields", f: f, care_record: @care_record %>

    <%= hidden_field_tag :return_to, @return_to if @return_to %>
    <%= f.submit "更新する", class: "btn btn-primary mt-2" %>
  <% end %>

  <%= render "shared/preset_modal" %>
</div>
