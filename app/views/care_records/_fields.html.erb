<%# locals: (f:, care_record:) %>
<div class="form-control">
  <span class="label">記録の種類</span>
  <p><%= CareRecord::RECORD_TYPE_LABELS[care_record.record_type] %></p>
  <%= f.hidden_field :record_type %>
</div>

<div class="form-control">
  <%= f.label :recorded_at, "記録日時", class: "label" %>
  <span class="text-xs opacity-70 mb-1">24時間表記で入力してください</span>
  <%= f.datetime_field :recorded_at, step: 60,
        value: f.object.recorded_at&.strftime("%Y-%m-%dT%H:%M"),
        class: "input input-bordered w-full" %>
</div>

<% case care_record.record_type %>
<% when "meal" %>
  <%= f.fields_for :meal do |m| %>
    <div class="form-control" data-controller="meal-type-picker">
      <%= m.label :food_name, "食事の種類", class: "label" %>
      <%= m.text_field :food_name, class: "input input-bordered w-full", data: { meal_type_picker_target: "input" } %>
      <% if @meal_types.present? %>
        <div class="flex flex-wrap gap-2 mt-2">
          <% @meal_types.each do |meal_type| %>
            <button type="button" class="btn btn-xs btn-outline"
                    data-action="meal-type-picker#select"
                    data-meal-type-picker-name-param="<%= meal_type.name %>">
              <%= meal_type.name %>
            </button>
          <% end %>
        </div>
      <% end %>
      <p class="text-xs opacity-70 mt-1">
        <%= link_to "食事の種類を管理する", meal_types_path(return_to: request.fullpath), class: "link", data: { action: "preset-modal#open" } %>
      </p>
    </div>
    <div class="form-control">
      <%= m.label :amount, "食事量", class: "label" %>
      <div class="flex items-center gap-2" data-controller="meal-type-picker">
        <div class="join w-full">
          <%= m.text_field :amount, class: "input input-bordered join-item w-full", inputmode: "decimal" %>
          <span class="btn no-animation join-item pointer-events-none" data-meal-type-picker-target="display"><%= m.object.unit.presence || "g" %></span>
        </div>
        <%= m.hidden_field :unit, value: m.object.unit.presence || "g", data: { meal_type_picker_target: "input" } %>
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-outline btn-sm whitespace-nowrap">単位変更はこちら</div>
          <div tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-64 p-3 shadow mt-1">
            <% if @meal_units.present? %>
              <div class="flex flex-wrap gap-2">
                <% @meal_units.each do |meal_unit| %>
                  <button type="button" class="btn btn-xs btn-outline"
                          data-action="meal-type-picker#select"
                          data-meal-type-picker-name-param="<%= meal_unit.name %>">
                    <%= meal_unit.name %>
                  </button>
                <% end %>
              </div>
            <% else %>
              <p class="text-xs opacity-70">登録済みの単位がありません</p>
            <% end %>
            <p class="text-xs opacity-70 mt-2">
              <%= link_to "食事の単位を管理する", meal_units_path(return_to: request.fullpath), class: "link", data: { action: "preset-modal#open" } %>
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="form-control">
      <%= m.label :completion_rate, "完食率", class: "label" %>
      <%= render "shared/icon_picker",
            field_name: "care_record[meal_attributes][completion_rate]",
            field_id: "care_record_meal_attributes_completion_rate",
            selected_value: m.object.completion_rate&.to_i,
            options: Meal::COMPLETION_RATE_OPTIONS %>
    </div>
  <% end %>
<% when "water" %>
  <%= f.fields_for :water do |wt| %>
    <div class="form-control">
      <%= wt.label :amount, "水の量(ml)", class: "label" %>
      <%= wt.text_field :amount, class: "input input-bordered w-full", inputmode: "decimal" %>
    </div>
  <% end %>
<% when "weight" %>
  <%= f.fields_for :weight do |w| %>
    <div class="form-control">
      <%= w.label :weight, "体重(kg)", class: "label" %>
      <%= w.text_field :weight, class: "input input-bordered w-full", inputmode: "decimal" %>
    </div>
  <% end %>
<% when "temperature" %>
  <%= f.fields_for :temperature do |t| %>
    <div class="form-control">
      <%= t.label :temperature, "体温(℃)", class: "label" %>
      <%= t.text_field :temperature, class: "input input-bordered w-full", inputmode: "decimal" %>
    </div>
  <% end %>
<% when "medication" %>
  <%= f.fields_for :medication do |m| %>
    <div class="form-control" data-controller="meal-type-picker">
      <%= m.label :medicine_name, "薬の名前", class: "label" %>
      <%= m.text_field :medicine_name, class: "input input-bordered w-full", data: { meal_type_picker_target: "input" } %>
      <% if @medicine_types.present? %>
        <div class="flex flex-wrap gap-2 mt-2">
          <% @medicine_types.each do |medicine_type| %>
            <button type="button" class="btn btn-xs btn-outline"
                    data-action="meal-type-picker#select"
                    data-meal-type-picker-name-param="<%= medicine_type.name %>">
              <%= medicine_type.name %>
            </button>
          <% end %>
        </div>
      <% end %>
      <p class="text-xs opacity-70 mt-1">
        <%= link_to "薬の種類を管理する", medicine_types_path(return_to: request.fullpath), class: "link", data: { action: "preset-modal#open" } %>
      </p>
    </div>
    <div class="form-control">
      <%= m.label :dosage_amount, "容量", class: "label" %>
      <div class="flex gap-2">
        <%= m.text_field :dosage_amount, class: "input input-bordered w-full", inputmode: "decimal" %>
        <%= m.select :dosage_unit, Medication::DOSAGE_UNITS, { include_blank: "単位" }, class: "select select-bordered" %>
      </div>
    </div>
  <% end %>
<% when "toilet" %>
  <%= f.fields_for :toilet do |t| %>
    <div class="form-control" data-controller="toilet-form">
      <%= t.label :kind, "種類", class: "label" %>
      <%= render "shared/icon_picker",
            field_name: "care_record[toilet_attributes][kind]",
            field_id: "care_record_toilet_attributes_kind",
            selected_value: t.object.kind,
            options: Toilet::KIND_OPTIONS,
            extra_action: "toilet-form#toggle",
            extra_input_data: { toilet_form_target: "kindInput" } %>

      <div data-toilet-form-target="conditionSection" class="mt-4">
        <%= t.label :condition, "状態", class: "label" %>
        <%= render "shared/icon_picker",
              field_name: "care_record[toilet_attributes][condition]",
              field_id: "care_record_toilet_attributes_condition",
              selected_value: t.object.condition,
              options: Toilet::CONDITION_OPTIONS %>
      </div>
    </div>
  <% end %>
<% when "walk" %>
  <%= f.fields_for :walk do |w| %>
    <div class="form-control">
      <%= w.label :duration_minutes, "散歩時間(分)", class: "label" %>
      <%= w.text_field :duration_minutes, class: "input input-bordered w-full", inputmode: "decimal" %>
    </div>
    <div class="form-control">
      <%= w.label :distance, "距離(km)", class: "label" %>
      <%= w.text_field :distance, class: "input input-bordered w-full", inputmode: "decimal" %>
    </div>
  <% end %>
<% when "hospital_visit" %>
  <%= f.fields_for :hospital_visit do |h| %>
    <div class="form-control" data-controller="meal-type-picker">
      <%= h.label :hospital_name, "病院名", class: "label" %>
      <%= h.text_field :hospital_name, class: "input input-bordered w-full", data: { meal_type_picker_target: "input" } %>
      <% if @hospital_names.present? %>
        <div class="flex flex-wrap gap-2 mt-2">
          <% @hospital_names.each do |hospital_name| %>
            <button type="button" class="btn btn-xs btn-outline"
                    data-action="meal-type-picker#select"
                    data-meal-type-picker-name-param="<%= hospital_name.name %>">
              <%= hospital_name.name %>
            </button>
          <% end %>
        </div>
      <% end %>
      <p class="text-xs opacity-70 mt-1">
        <%= link_to "病院名を管理する", hospital_names_path(return_to: request.fullpath), class: "link", data: { action: "preset-modal#open" } %>
      </p>
    </div>
    <div class="form-control" data-controller="meal-type-picker">
      <%= h.label :vaccine_type, "ワクチンの種類", class: "label" %>
      <%= h.text_field :vaccine_type, class: "input input-bordered w-full", data: { meal_type_picker_target: "input" } %>
      <% if @vaccine_types.present? %>
        <div class="flex flex-wrap gap-2 mt-2">
          <% @vaccine_types.each do |vaccine_type| %>
            <button type="button" class="btn btn-xs btn-outline"
                    data-action="meal-type-picker#select"
                    data-meal-type-picker-name-param="<%= vaccine_type.name %>">
              <%= vaccine_type.name %>
            </button>
          <% end %>
        </div>
      <% end %>
      <p class="text-xs opacity-70 mt-1">
        <%= link_to "ワクチンの種類を管理する", vaccine_types_path(return_to: request.fullpath), class: "link", data: { action: "preset-modal#open" } %>
      </p>
    </div>
    <div class="form-control">
      <%= h.label :diagnosis, "診断内容", class: "label" %>
      <%= h.text_area :diagnosis, class: "textarea textarea-bordered w-full" %>
    </div>
  <% end %>
<% when "care" %>
  <%= f.fields_for :care do |c| %>
    <div class="form-control">
      <%= c.label :care_type, "お手入れの種類", class: "label" %>
      <%= render "shared/icon_picker",
            field_name: "care_record[care_attributes][care_type]",
            field_id: "care_record_care_attributes_care_type",
            selected_value: c.object.care_type,
            options: Care::CARE_TYPE_OPTIONS %>
    </div>
  <% end %>
<% end %>

<div class="form-control">
  <%= f.label :note, "メモ", class: "label" %>
  <%= f.text_area :note, class: "textarea textarea-bordered w-full" %>
</div>

<div class="form-control">
  <%= label_tag "care_record_files", "添付ファイル(画像・動画・書類)", class: "label" %>
  <%= file_field_tag "care_record[files][]", multiple: true, class: "file-input file-input-bordered w-full" %>
</div>
