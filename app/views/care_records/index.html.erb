<div class="max-w-md mx-auto w-full">
  <%= link_to "← #{@pet.name}のページに戻る", pet_path(@pet), class: "link text-sm mb-4 inline-block" %>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">
      <%= @record_type ? "#{CareRecord::RECORD_TYPE_LABELS[@record_type]}の記録一覧" : "全記録一覧" %>
    </h1>
    <% if @record_type %>
      <%= link_to "＋", new_pet_care_record_path(@pet, record_type: @record_type), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>

  <%= form_with url: pet_care_records_path(@pet), method: :get, class: "flex flex-wrap items-end gap-2 mb-4" do %>
    <%= hidden_field_tag :record_type, @record_type if @record_type %>
    <div class="form-control">
      <label for="from" class="label text-xs">開始日</label>
      <input type="date" name="from" id="from" value="<%= @from %>" class="input input-bordered input-sm" />
    </div>
    <div class="form-control">
      <label for="to" class="label text-xs">終了日</label>
      <input type="date" name="to" id="to" value="<%= @to %>" class="input input-bordered input-sm" />
    </div>
    <button type="submit" class="btn btn-sm btn-outline">絞り込む</button>
    <% if @from || @to %>
      <%= link_to "解除", pet_care_records_path(@pet, record_type: @record_type), class: "btn btn-sm btn-ghost" %>
    <% end %>
  <% end %>

  <% @graph_series.each do |series| %>
    <div class="mb-6">
      <h2 class="font-bold mb-2"><%= series[:label] %>の推移</h2>
      <canvas data-controller="line-chart"
              data-line-chart-labels-value="<%= series[:points].map { |p| p[:date] }.to_json %>"
              data-line-chart-data-value="<%= series[:points].map { |p| p[:value] }.to_json %>"
              data-line-chart-label-value="<%= series[:label] %>"></canvas>
    </div>
  <% end %>

  <% if @care_records.present? %>
    <ul class="flex flex-col gap-2">
      <% @care_records.each do |care_record| %>
        <li>
          <%= link_to pet_care_record_path(@pet, care_record), class: "flex items-center justify-between gap-2 p-3 rounded border border-base-300" do %>
            <span class="badge badge-outline"><%= CareRecord::RECORD_TYPE_LABELS[care_record.record_type] %></span>
            <span class="flex-1 text-left px-2"><%= care_record.detail_summary %></span>
            <span class="text-sm opacity-70"><%= care_record.recorded_at.strftime("%Y/%m/%d %H:%M") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>まだケア記録がありません。</p>
  <% end %>
</div>
