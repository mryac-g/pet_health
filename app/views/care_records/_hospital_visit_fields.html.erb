<%# locals: (f:) %>
<%= f.fields_for :hospital_visit do |h| %>
  <div class="form-control" data-controller="meal-type-picker">
    <%= h.label :hospital_name, "病院名", class: "label" %>
    <%= h.text_field :hospital_name, class: "input input-bordered w-full", data: { meal_type_picker_target: "input" } %>
    <% if @hospital_names.present? %>
      <div class="flex flex-wrap gap-2 mt-2">
        <% @hospital_names.each do |hospital_name| %>
          <button type="button" class="btn btn-xs btn-outline"
                  data-action="meal-type-picker#select"
                  data-meal-type-picker-name-param="<%= hospital_name.name %>">
            <%= hospital_name.name %>
          </button>
        <% end %>
      </div>
    <% end %>
    <p class="text-xs opacity-70 mt-1">
      <%= link_to "病院名を管理する", hospital_names_path(return_to: request.fullpath), class: "link", data: { action: "preset-modal#open" } %>
    </p>
  </div>
  <div class="form-control" data-controller="meal-type-picker disclosure">
    <button type="button"
            class="btn btn-outline btn-sm w-fit <%= "hidden" if h.object.vaccine_type.present? %>"
            data-disclosure-target="trigger" data-action="disclosure#toggle">
      ワクチンを入力する
    </button>

    <div class="flex flex-col gap-2 <%= "hidden" unless h.object.vaccine_type.present? %>" data-disclosure-target="content">
      <div class="flex items-center justify-between">
        <%= h.label :vaccine_type, "ワクチンの種類", class: "label" %>
        <button type="button" class="btn btn-ghost btn-xs" data-action="disclosure#toggle" aria-label="ワクチンの種類の入力を閉じる">✕</button>
      </div>
      <%= h.text_field :vaccine_type, class: "input input-bordered w-full", data: { meal_type_picker_target: "input" } %>
      <% if @vaccine_types.present? %>
        <div class="flex flex-wrap gap-2">
          <% @vaccine_types.each do |vaccine_type| %>
            <button type="button" class="btn btn-xs btn-outline"
                    data-action="meal-type-picker#select"
                    data-meal-type-picker-name-param="<%= vaccine_type.name %>">
              <%= vaccine_type.name %>
            </button>
          <% end %>
        </div>
      <% end %>
      <p class="text-xs opacity-70">
        <%= link_to "ワクチンの種類を管理する", vaccine_types_path(return_to: request.fullpath), class: "link", data: { action: "preset-modal#open" } %>
      </p>
    </div>
  </div>
  <div class="form-control">
    <%= h.label :diagnosis, "診断内容", class: "label" %>
    <%= h.text_area :diagnosis, class: "textarea textarea-bordered w-full" %>
  </div>
<% end %>
