<!DOCTYPE html>
<html data-theme="light">
  <head>
    <meta charset="utf-8">
    <title>うちの子ライフ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen md:flex bg-base-200">
    <% if user_signed_in? %>
      <aside class="md:w-64 md:flex-shrink-0 bg-base-200 md:border-r md:border-base-300 print:hidden">
        <div class="flex items-center justify-between md:flex-col md:items-stretch md:justify-start md:h-screen md:sticky md:top-0 p-4">
          <%= link_to root_path, class: "flex items-center gap-2 md:mb-8" do %>
            <%= render "shared/species_icon", species: "dog", class: "w-6 h-6 text-primary" %>
            <span class="text-lg font-bold">うちの子ライフ</span>
          <% end %>

          <nav class="hidden md:flex md:flex-col gap-1 md:flex-1">
            <% if @pet.present? && @pet.persisted? && !(controller_name == "pets" && action_name == "show") %>
              <%= link_to "#{@pet.name}のページに戻る", pet_path(@pet), class: "px-3 py-2 rounded-lg text-sm hover:bg-base-100" %>
            <% end %>
            <%= link_to root_path, class: "px-3 py-2 rounded-lg font-bold #{'bg-base-100' if current_page?(root_path)}" do %>
              ホーム
            <% end %>
          </nav>

          <div class="hidden md:flex items-center justify-between md:border-t md:border-base-300 md:pt-4">
            <div class="flex items-center gap-2 min-w-0">
              <div class="w-8 h-8 rounded-full bg-primary/15 text-primary flex items-center justify-center text-sm font-bold flex-shrink-0">
                <%= current_user.display_name.first %>
              </div>
              <span class="text-sm truncate"><%= current_user.display_name %></span>
            </div>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-xs btn-ghost" %>
          </div>

          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-sm btn-ghost md:hidden" %>
        </div>
      </aside>
    <% else %>
      <div class="navbar bg-base-100 border-b border-base-300 px-4 sm:px-6 print:hidden">
        <div class="flex-1">
          <%= link_to "うちの子ライフ", root_path, class: "text-lg font-bold" %>
        </div>
      </div>
    <% end %>

    <div class="flex-1 min-w-0">
      <% if notice || alert %>
        <div class="toast toast-top toast-center z-50 print:hidden">
          <% if notice %>
            <div role="alert" class="alert alert-success"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div role="alert" class="alert alert-error"><%= alert %></div>
          <% end %>
        </div>
      <% end %>

      <main class="container mx-auto px-4 sm:px-6 py-8 flex flex-col">
        <%= yield %>
      </main>
    </div>

    <dialog id="turbo-confirm" class="modal">
      <div class="modal-box">
        <p class="py-2"></p>
        <form method="dialog" class="modal-action">
          <button value="cancel" class="btn btn-ghost">キャンセル</button>
          <button value="confirm" class="btn btn-error">OK</button>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button value="cancel">close</button>
      </form>
    </dialog>
  </body>
</html>
