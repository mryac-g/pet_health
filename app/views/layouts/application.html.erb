<!DOCTYPE html>
<html data-theme="light">
  <head>
    <meta charset="utf-8">
    <title>うちの子ライフ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="navbar bg-base-100 border-b border-base-300 px-4 sm:px-6 print:hidden">
      <div class="flex-1">
        <%= link_to "うちの子ライフ", root_path, class: "text-lg font-bold" %>
      </div>
      <% if user_signed_in? %>
        <div class="flex-none flex items-center gap-2">
          <% if @pet.present? && @pet.persisted? && !(controller_name == "pets" && action_name == "show") %>
            <%= link_to "#{@pet.name}のページに戻る", pet_path(@pet), class: "btn btn-sm btn-outline" %>
          <% end %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-sm btn-ghost" %>
        </div>
      <% end %>
    </div>

    <main class="container mx-auto px-4 sm:px-6 py-8 flex flex-col">
      <% if notice %>
        <div role="alert" class="alert alert-success mb-4 print:hidden"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div role="alert" class="alert alert-error mb-4 print:hidden"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
