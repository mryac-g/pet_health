<!DOCTYPE html>
<html data-theme="light">
  <head>
    <meta charset="utf-8">
    <title>うちの子ノート</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen <%= user_signed_in? ? "bg-base-200 md:flex" : "bg-orange-50" %>"
    <% unless user_signed_in? %>
      style="background-image: url('<%= image_path("welcome/background_pattern.png") %>'), radial-gradient(1200px 720px at 50% -10%, #fff1eb, #ffd6d2 72%); background-repeat: no-repeat, no-repeat; background-size: cover, cover; background-position: center, center; background-attachment: fixed, fixed;"
    <% end %>
  >
    <% if user_signed_in? %>
      <aside class="md:w-64 md:flex-shrink-0 bg-base-300 md:border-r md:border-base-300 print:hidden">
        <div class="flex items-center justify-between md:flex-col md:items-stretch md:justify-start md:h-screen md:sticky md:top-0 p-4">
          <%= link_to root_path, class: "flex items-center gap-2 md:mb-8" do %>
            <%= render "shared/paw_icon", class: "w-6 h-6" %>
            <span class="text-lg font-bold">うちの子ノート</span>
          <% end %>

          <nav class="hidden md:flex md:flex-col gap-1 md:flex-1">
            <%= link_to root_path, class: "px-3 py-2 rounded-lg border-l-4 font-bold #{current_page?(root_path) ? 'bg-base-100 border-primary' : 'border-transparent'}" do %>
              ホーム
            <% end %>

            <% sidebar_pets = Array(@pets).select(&:persisted?) %>
            <% if sidebar_pets.size > 1 %>
              <p class="text-xs opacity-50 px-3 mt-4 mb-1">ペット切り替え</p>
              <% sidebar_pets.each do |pet| %>
                <%= link_to pet.name, pet_path(pet), class: "px-3 py-2 rounded-lg border-l-4 text-sm #{pet == @pet ? 'bg-base-100 border-primary font-bold' : 'border-transparent hover:bg-base-100'}" %>
              <% end %>
            <% end %>

            <% if current_user.admin? %>
              <p class="text-xs opacity-50 px-3 mt-4 mb-1">管理者メニュー</p>
              <%= link_to "お問い合わせ一覧", admin_inquiries_path, class: "px-3 py-2 rounded-lg border-l-4 text-sm #{current_page?(admin_inquiries_path) ? 'bg-base-100 border-primary font-bold' : 'border-transparent hover:bg-base-100'}" %>
            <% end %>
          </nav>

          <%= link_to new_pet_path, class: "hidden md:flex md:w-full btn btn-primary btn-sm mb-4" do %>
            + ペットを登録する
          <% end %>

          <div class="hidden md:flex items-center justify-between md:border-t md:border-base-300 md:pt-4">
            <%= link_to edit_user_registration_path, class: "flex items-center gap-2 min-w-0 flex-1 mr-2 px-2 py-1.5 rounded-lg transition-colors hover:bg-primary/15" do %>
              <div class="w-8 h-8 rounded-full bg-primary/15 text-primary flex items-center justify-center text-sm font-bold flex-shrink-0">
                <%= current_user.display_name.first %>
              </div>
              <span class="text-sm truncate"><%= current_user.display_name %></span>
            <% end %>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-xs btn-ghost" %>
          </div>

          <div class="hidden md:flex flex-wrap gap-x-3 gap-y-1 px-1 pt-3 text-xs opacity-60">
            <%= link_to "お問い合わせ", new_inquiry_path, class: "hover:underline" %>
            <%= link_to "利用規約", terms_path, class: "hover:underline" %>
            <%= link_to "プライバシーポリシー", privacy_path, class: "hover:underline" %>
          </div>

          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-sm btn-ghost md:hidden" %>
        </div>
      </aside>
    <% else %>
      <div class="navbar flex-nowrap gap-x-3 px-4 sm:px-6 bg-base-100 print:hidden">
        <div class="flex-1 min-w-0">
          <%= link_to root_path, class: "flex min-w-0" do %>
            <%= render "shared/brand_logo" %>
          <% end %>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <%= link_to "ログイン", new_user_session_path, class: "btn btn-xs btn-ghost rounded-full text-[var(--muted)]" %>
          <%= link_to "アカウント登録", new_user_registration_path, class: "btn btn-xs btn-outline rounded-full text-[var(--muted)]" %>
        </div>
      </div>
    <% end %>

    <div class="flex-1 min-w-0">
      <%# ドキュメントの流れに乗せず固定表示することで、メッセージの有無に関わらず
          下のコンテンツの位置がずれないようにする(issue #158)。ただしモバイルでは
          成功メッセージ(notice)を出さず、失敗メッセージ(alert)も数秒で消えるだけの
          ものなので、常時の上余白は確保しない(操作領域が狭くなるため) %>
      <div class="toast toast-top toast-center z-50 print:hidden" data-controller="flash">
        <% if notice %>
          <div role="alert" class="alert bg-base-content text-base-100 hidden md:block"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div role="alert" class="alert alert-error"><%= alert %></div>
        <% end %>
      </div>

      <%# 固定表示のトーストとページ上部のコンテンツ(長いペット名など)が重ならないよう、
          トーストの高さを常に上回る分の余白を上部に確保しておく(デスクトップのみ) %>
      <main class="container mx-auto px-4 sm:px-6 pt-4 md:pt-24 pb-8 flex flex-col">
        <%= yield %>
      </main>

      <footer class="print:hidden py-6 text-center text-xs opacity-60 flex flex-wrap justify-center gap-x-4 gap-y-1 <%= "md:hidden" if user_signed_in? %>">
        <%= link_to "お問い合わせ", user_signed_in? ? new_inquiry_path : new_user_session_path, class: "hover:underline" %>
        <%= link_to "利用規約", terms_path, class: "hover:underline" %>
        <%= link_to "プライバシーポリシー", privacy_path, class: "hover:underline" %>
      </footer>
    </div>

    <dialog id="turbo-confirm" class="modal">
      <div class="modal-box">
        <p class="py-2"></p>
        <form method="dialog" class="modal-action">
          <button value="cancel" class="btn btn-ghost">キャンセル</button>
          <button value="confirm" class="btn btn-error">OK</button>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button value="cancel">close</button>
      </form>
    </dialog>
  </body>
</html>
