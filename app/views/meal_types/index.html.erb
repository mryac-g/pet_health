<div class="max-w-md mx-auto w-full">
  <h1 class="text-2xl font-bold mb-6">食事の種類を管理</h1>

  <% if @meal_type.errors.any? %>
    <div role="alert" class="alert alert-error mb-4">
      <ul>
        <% @meal_type.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @meal_type, url: meal_types_path, local: true, class: "flex gap-2 mb-6" do |f| %>
    <%= f.text_field :name, placeholder: "例: ドライフードA", class: "input input-bordered w-full" %>
    <%= f.submit "追加", class: "btn btn-primary" %>
  <% end %>

  <% if @meal_types.present? %>
    <ul class="flex flex-col gap-2">
      <% @meal_types.each do |meal_type| %>
        <li class="flex items-center justify-between gap-2 p-3 rounded border border-base-300">
          <span><%= meal_type.name %></span>
          <%= button_to "削除", meal_type_path(meal_type), method: :delete,
                class: "btn btn-xs btn-error",
                data: { turbo_confirm: "「#{meal_type.name}」を削除しますか？" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>まだ食事の種類が登録されていません。</p>
  <% end %>

  <%= link_to "戻る", root_path, class: "btn btn-sm mt-6" %>
</div>
