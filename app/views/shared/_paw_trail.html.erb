<%# 肉球の足跡を、歩いているかのように1つずつ順番に表示するアニメーション付きイラスト %>
<% paw_count = 13 %>
<% start_x = 20 %>
<% step_x = 35 %>
<svg viewBox="0 0 480 90" class="w-52 h-auto mx-auto mb-8" role="img" aria-label="肉球の足跡が順番に現れるイラスト">
  <style>
    .paw-print {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      animation: paw-step .5s ease-out forwards;
    }
    @keyframes paw-step {
      0% { opacity: 0; transform: scale(.4) translateY(-6px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
  </style>
  <% paw_count.times do |i| %>
    <% cx = start_x + (i * step_x) %>
    <% cy = i.even? ? 55 : 35 %>
    <% rotation = i.even? ? -12 : 12 %>
    <% delay = i * 0.15 %>
    <g transform="translate(<%= cx %>, <%= cy %>) rotate(<%= rotation %>)">
      <g class="paw-print" style="animation-delay: <%= delay %>s" fill="#ff5a4d">
        <ellipse cx="0" cy="8" rx="6.5" ry="8.5" />
        <ellipse cx="-7" cy="-5" rx="2.6" ry="3.6" />
        <ellipse cx="-2.5" cy="-9" rx="2.6" ry="3.6" />
        <ellipse cx="2.5" cy="-9" rx="2.6" ry="3.6" />
        <ellipse cx="7" cy="-5" rx="2.6" ry="3.6" />
      </g>
    </g>
  <% end %>
</svg>
