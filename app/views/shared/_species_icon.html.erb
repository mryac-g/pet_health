<% case species %>
<% when "dog", "other" %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="<%= local_assigns[:class] || "w-6 h-6" %>">
    <circle cx="12" cy="16" r="4.2"/>
    <circle cx="5.5" cy="9.5" r="2"/>
    <circle cx="10" cy="5" r="2"/>
    <circle cx="14" cy="5" r="2"/>
    <circle cx="18.5" cy="9.5" r="2"/>
  </svg>
<% when "cat" %>
