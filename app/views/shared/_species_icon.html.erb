    <path d="M6.8 8.2 4.8 4l4 2.2"/>
    <path d="M17.2 8.2 19.2 4l-4 2.2"/>
    <circle cx="9.5" cy="13.5" r=".6" fill="currentColor"/>
    <circle cx="14.5" cy="13.5" r=".6" fill="currentColor"/>
