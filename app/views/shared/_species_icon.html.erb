  </svg>
<% when "bird" %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="<%= local_assigns[:class] || "w-6 h-6" %>">
    <path d="M4.5 14.5c0-5.2 4-9.3 9-9.3 3 0 5 1.1 6.2 2.9-1 .1-2 .4-2.8 1.1 2 .8 3.1 2.7 3.1 4.9-2 .1-3.2-.6-4.1-1.7.1 3.2-3 6.1-7 6.1-2 0-3.3-.8-4.2-1.8 1-.1 1.9-.6 2-1.5-1.1-.1-2.2-.3-2.2-.7Z"/>
    <circle cx="15.3" cy="8.3" r=".6" fill="currentColor"/>
  </svg>
<% end %>
